# .env.local
# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=your_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token

# Upstash Realtime Configuration  
UPSTASH_REALTIME_URL=your_realtime_url
UPSTASH_REALTIME_TOKEN=your_realtime_token

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
ROOM_EXPIRY_TIME=3600

# Example values (replace with your actual Upstash credentials):
# UPSTASH_REDIS_REST_URL=https://us1-helpful-swan-12345.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AY1234567890ABCDEFGHIJKLMNOPQRSTUV
# UPSTASH_REALTIME_URL=https://realtime.upstash.io/v2
# UPSTASH_REALTIME_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...